PORT=8787
ALLOWED_ORIGIN=https://fuan20070330-sudo.github.io
WS_HEARTBEAT_MS=30000
DATA_FILE=./data/luyun-store.json

# 可选：PDF、DOCX、OCR、音频转写的服务端解析器。
DOCUMENT_EXTRACTOR_URL=
DOCUMENT_EXTRACTOR_API_KEY=
DOCUMENT_EXTRACTOR_TIMEOUT_MS=60000

# 高级模型配置。密钥只存在于后端环境变量中，前端不可见。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6
OPENAI_BASE_URL=https://api.openai.com/v1
AI_API_MODE=responses
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=6000

# 可选：OpenAI 兼容的 Chat Completions 备用地址
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# PostgreSQL 正式数据层（推荐生产环境）
DATABASE_URL=
DATABASE_SSL=false
PG_POOL_MAX=10

# 会话安全。生产环境使用 HTTPS + HttpOnly Cookie + CSRF。
AUTH_COOKIE_ENABLED=true
AUTH_RETURN_TOKEN=false
COOKIE_SECURE=true
COOKIE_SAME_SITE=None
SESSION_COOKIE_MAX_AGE=2592000
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=10

# 可选：官方名录、证书、商标或第三方权威核验服务。
OFFICIAL_VERIFICATION_URL=
OFFICIAL_VERIFICATION_API_KEY=
OFFICIAL_VERIFICATION_TIMEOUT_MS=30000
